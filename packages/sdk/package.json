{
  "name": "@nexera-foundation/erc7208-sdk",
  "version": "0.0.2-dev",
  "description": "TypeScript SDK for ERC-7208 contracts",
  "license": "MIT",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexera-Foundation/erc7208-core.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "yarn copy-abis && tsc -p tsconfig.build.json",
    "prepublishOnly": "yarn build",
    "copy-abis": "mkdir -p src/abi && find ../contracts/artifacts/contracts -type f -name '*.json' ! -path '*/build-info/*' ! -name '*.dbg.json' ! -name 'artifacts.d.ts' -exec sh -c 'cp \"$1\" src/abi/\"$(basename \"$1\")\"' _ {} \\;",
    "clean": "rm -rf dist src/abi"
  },
  "dependencies": {
    "ethers": "^6.13.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": ">=4.5.0"
  }
}
